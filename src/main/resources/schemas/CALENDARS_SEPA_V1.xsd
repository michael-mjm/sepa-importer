<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!-- definition of restrictions -->
    <!-- generic -->
    <xs:simpleType name="filetypeType">
        <xs:restriction base="xs:string">
            <xs:pattern value="full|delta"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="modification_flagType">
        <xs:restriction base="xs:string">
            <xs:pattern value="A|M|D"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="record_keyType">
        <xs:restriction base="xs:string">
            <xs:pattern value="CA[0-9A-Z]{10}"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="record_structureType">
        <xs:restriction base="xs:string">
            <xs:pattern value="COUNTRY HOLIDAY|PUBLICATION SCHEDULE|TIME ZONE|SERVICE PMI HOLIDAY"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="record_contentType">
        <xs:restriction base="xs:string">
            <xs:pattern value="D|H"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="record_statusType">
        <xs:restriction base="xs:string">
            <xs:pattern value="RECORD STATUS|C"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="startDateType">
        <xs:restriction base="xs:string">
            <xs:pattern value="START DATE|([0-9]{4}-[0-9]{2}-[0-9]{2})*"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="stopDateType">
        <xs:restriction base="xs:string">
            <xs:pattern value="STOP DATE|([0-9]{4}-[0-9]{2}-[0-9]{2})*"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="attribute_1Type">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Za-z0-9_\-/ ]*"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="attribute_2Type">
        <xs:restriction base="xs:string">
            <xs:pattern value="COUNTRY CODE|FILE DATE|SERVICE ID|[A-Z0-9 ]*|[A-Z]{2}|[0-9]{4}-[0-9]{2}-[0-9]{2}"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="attribute_3_15Type">
        <xs:restriction base="xs:token">
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="attribute_16_50Type">
        <xs:restriction base="xs:string">
            <xs:pattern value=""/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="file_dateType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9]{8}"/>
        </xs:restriction>
    </xs:simpleType>

